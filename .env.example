# Waitlist provider endpoint. Must be a PUBLIC form/subscribe URL that accepts a
# browser POST — never a key-bearing admin API. Works with Buttondown, Kit,
# Formspree, MailerLite and similar. Leave unset locally to exercise the
# unconfigured state.
VITE_WAITLIST_ENDPOINT=

# Field name the provider expects for the address. Buttondown/Kit use "email",
# Formspree accepts "email" too. Override only if your provider differs.
VITE_WAITLIST_FIELD=email

# Base path for the build. "/" for a custom domain or a user/org Pages site,
# "/<repo>/" for a project Pages site.
VITE_BASE=/
