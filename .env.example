# Waitlist provider endpoint. Must be a PUBLIC form/subscribe URL that accepts a
# browser POST — never a key-bearing admin API. Leave unset locally to exercise
# the unconfigured state.
#
# Brevo:     https://sibforms.com/serve/<id>
# Buttondown https://buttondown.com/api/emails/embed-subscribe/<user>
VITE_WAITLIST_ENDPOINT=

# Field name the provider expects for the address.
# Brevo uses EMAIL; Buttondown, Kit and Formspree use email.
VITE_WAITLIST_FIELD=email

# Wire format: "json" (Buttondown, Kit, Formspree) or "form" (Brevo).
VITE_WAITLIST_FORMAT=json

# Base path for the build. "/" for a custom domain or user/org Pages site,
# "/<repo>/" for a project Pages site.
VITE_BASE=/
